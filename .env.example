# ---------------------------------------------------------------------------
# MMA SPY ASSOCIATION — copie para .env e preencha o que for usar
# ---------------------------------------------------------------------------

# Banco (SQLite local, nada a configurar)
DATABASE_URL="file:./dev.db"

# Onde salvar as mídias baixadas dos criativos
MEDIA_DIR="./media"

# ---------------------------------------------------------------------------
# FONTE 1 — API oficial da Meta Ad Library (usada só para mercados da UE)
# Cria um app em developers.facebook.com, confirma identidade para o
# Ad Library API e cola o token abaixo. Sem isso, mercados da UE são
# ignorados e tudo passa pelo scraper.
# ---------------------------------------------------------------------------
META_ADLIB_TOKEN=""
META_GRAPH_VERSION="v21.0"

# ---------------------------------------------------------------------------
# FONTE 2 — Scraper da Ad Library pública (todos os outros mercados + BR)
# ---------------------------------------------------------------------------
# Proxy opcional (residencial). Ex: http://user:pass@host:port
MMASPY_PROXY=""
# Quantas rolagens por palavra-chave (mais = mais anúncios, mais lento)
MMASPY_MAX_SCROLL="8"
# true = mostra o navegador enquanto raspa (debug)
MMASPY_HEADFUL="false"

# ---------------------------------------------------------------------------
# FILTROS
# ---------------------------------------------------------------------------
# Mínimo de anúncios no mesmo criativo para virar candidata
MIN_ADS_PER_CREATIVE="2"
# Mínimo de dias no ar
MIN_DAYS_ACTIVE="7"

# ---------------------------------------------------------------------------
# CAMADA DE VEREDITO (IA) — opcional. Deixe false para custo zero.
# Aceita qualquer endpoint compatível com a API da OpenAI.
# ---------------------------------------------------------------------------
VERDICT_ENABLED="false"
VERDICT_BASE_URL="https://api.openai.com/v1"
VERDICT_API_KEY=""
VERDICT_MODEL="gpt-4o-mini"
# Só gera veredito para ofertas com score >= isto
VERDICT_MIN_SCORE="60"

# ---------------------------------------------------------------------------
# ALERTAS — opcional (Telegram). Deixe vazio para desligar.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
