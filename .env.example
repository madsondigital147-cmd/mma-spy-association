# ---------------------------------------------------------------------------
# MMA SPY ASSOCIATION — copie para .env e preencha
# ---------------------------------------------------------------------------

# BANCO — Neon (Postgres, free tier). Pegue as strings em:
#   console.neon.tech  ->  projeto "mma-spy-association"  ->  Connect
#   - DATABASE_URL          = a "Pooled connection" (…-pooler…), use no app
#   - DATABASE_URL_UNPOOLED = a "Direct connection" (sem -pooler), use nas migrations
DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASS@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Onde salvar as mídias baixadas dos criativos (local; no deploy isso fica efêmero)
MEDIA_DIR="./media"

# ---------------------------------------------------------------------------
# LOGIN — deixe vazio para rodar ABERTO (uso local). Preencha para exigir login
# (obrigatório se expor na web). Gere os valores com:
#   npm run hash-password -- "sua senha longa"
# AUTH_USERS aceita vários: "matheus:HASH1,socio:HASH2"
# ---------------------------------------------------------------------------
AUTH_USERS=""
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# FONTE 1 — API oficial da Meta Ad Library (usada só para mercados da UE)
# ---------------------------------------------------------------------------
META_ADLIB_TOKEN=""
META_GRAPH_VERSION="v21.0"

# ---------------------------------------------------------------------------
# FONTE 2 — Scraper da Ad Library pública (todos os outros mercados + BR)
# ---------------------------------------------------------------------------
MMASPY_PROXY=""
MMASPY_MAX_SCROLL="8"
MMASPY_HEADFUL="false"

# ---------------------------------------------------------------------------
# FILTROS
# ---------------------------------------------------------------------------
MIN_ADS_PER_CREATIVE="2"
MIN_DAYS_ACTIVE="7"

# ---------------------------------------------------------------------------
# CAMADA DE VEREDITO (IA) — opcional. false = custo zero.
# ---------------------------------------------------------------------------
VERDICT_ENABLED="false"
VERDICT_BASE_URL="https://api.openai.com/v1"
VERDICT_API_KEY=""
VERDICT_MODEL="gpt-4o-mini"
VERDICT_MIN_SCORE="60"

# ---------------------------------------------------------------------------
# TRANSCRIÇÃO (Fase 2) — opcional. false = custo zero.
# Transcreve a fala do vídeo do anúncio pra busca por mecanismo / veredito.
# Aceita endpoint compatível com a API da OpenAI (/audio/transcriptions).
# ---------------------------------------------------------------------------
TRANSCRIBE_ENABLED="false"
TRANSCRIBE_BASE_URL="https://api.openai.com/v1"
TRANSCRIBE_API_KEY=""
TRANSCRIBE_MODEL="whisper-1"

# ---------------------------------------------------------------------------
# ALERTAS — opcional (Telegram)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
