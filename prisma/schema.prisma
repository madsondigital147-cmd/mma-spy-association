generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Um bloco de palavras-chave + nicho + mercados. É o que você cria na tela "Fontes".
model Source {
  id        String    @id @default(cuid())
  niche     String
  markets   String // csv de códigos de país: US,GB,DE,BR
  keywords  String // palavras-chave, uma por linha (texto cru colado)
  status    String    @default("active") // active | paused
  createdAt DateTime  @default(now())
  lastRunAt DateTime?
  runs      Run[]
  offers    Offer[]
}

/// Uma execução do minerador sobre uma Source.
model Run {
  id             String    @id @default(cuid())
  sourceId       String
  source         Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String    @default("running") // running | ok | error
  rawCount       Int       @default(0)
  creativeCount  Int       @default(0)
  candidateCount Int       @default(0)
  error          String?
}

/// Anúncio bruto capturado da Ad Library (API ou scraper).
model MinedAd {
  id            String         @id @default(cuid())
  adArchiveId   String         @unique
  sourceId      String?
  pageId        String
  pageName      String
  body          String?
  linkTitle     String?
  linkCaption   String?
  linkUrl       String?
  ctaText       String?
  countries     String         @default("") // csv
  platforms     String         @default("") // csv
  deliveryStart DateTime?
  deliveryStop  DateTime?
  active        Boolean        @default(true)
  snapshotUrl   String?
  mediaUrl      String?
  mediaType     String? // image | video
  mediaHash     String?
  euReach       Int?
  transcript    String? // fala do vídeo (opcional, se TRANSCRIBE_ENABLED)
  firstSeen     DateTime       @default(now())
  lastSeen      DateTime       @default(now())
  creativeId    String?
  creative      MinedCreative? @relation(fields: [creativeId], references: [id])

  @@index([creativeId])
  @@index([pageId])
}

/// Agrupamento de anúncios que usam a MESMA mídia/copy. Aqui sai o "N anúncios no criativo".
model MinedCreative {
  id             String    @id @default(cuid())
  mediaHash      String    @unique
  mediaType      String?
  sampleMedia    String?
  sampleBody     String?
  hookText       String? // 1ª linha da copy — texto do card
  adCount        Int       @default(0)
  pageCount      Int       @default(0)
  advertiserCount Int      @default(0) // páginas/anunciantes distintos usando este criativo
  firstSeen      DateTime  @default(now())
  lastSeen       DateTime  @default(now())
  ads            MinedAd[]
  offerId        String?
  offer          Offer?    @relation(fields: [offerId], references: [id])

  @@index([offerId])
  @@index([adCount])
}

/// A oferta consolidada — o que aparece na fila de review.
model Offer {
  id           String          @id @default(cuid())
  sourceId     String?
  source       Source?         @relation(fields: [sourceId], references: [id])
  title        String
  advertiser   String
  pageId       String
  niche        String?
  markets      String          @default("") // csv onde foi vista
  landingUrl   String?
  gateway      String?
  funnelType   String? // vsl | advertorial | direct | quiz | unknown
  language     String?
  adCount        Int           @default(0)
  pageCount      Int           @default(0)
  pageAdCount    Int           @default(0)
  topCreativeAds Int           @default(0) // maior nº de anúncios num único criativo desta oferta
  creativeCount  Int           @default(0) // criativos distintos desta oferta
  daysActive     Int           @default(0)
  trend        String          @default("new") // new | scaling | steady | fading | dead
  arbitrage    Boolean         @default(false)
  score        Int             @default(0)
  status       String          @default("new") // new | approved | testing | ignored
  verdict      String?
  verdictAngle String?
  // --- Fase 2/3: grafo de domínios + Google Ads Transparency ---
  trackingGa     String? // G-XXXX / UA-XXXX
  trackingGtm    String? // GTM-XXXX
  trackingPixel  String? // Facebook Pixel id
  trackingTiktok String? // TikTok pixel id
  sameIpDomains  String  @default("") // csv — domínios no mesmo IP (reverse IP)
  gatAdCount     Int? // nº de anúncios do domínio no Google Ads Transparency
  gatFirstSeen   DateTime?
  gatLastSeen    DateTime?
  // --- tech stack + curadoria ---
  techStack      String  @default("") // csv: VTurb,Cartpanda,Stripe,Atomicat…
  player         String? // player de vídeo detectado
  cloakerSuspect Boolean @default(false)
  favorite       Boolean @default(false)
  recommended    Boolean @default(false)
  recommendReason String?
  adSnapshotUrl  String? // link do anúncio na Biblioteca
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  creatives    MinedCreative[]
  snapshots    OfferSnapshot[]
  tests        OfferTest[]

  @@unique([pageId, title])
  @@index([status, score])
}

/// Foto diária de uma oferta — a série disso vira a tendência (escalando/murchando).
model OfferSnapshot {
  id          String   @id @default(cuid())
  offerId     String
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  at          DateTime @default(now())
  adCount     Int
  pageAdCount Int
  active      Boolean
  landingUrl  String?
  priceSeen   String?
}

/// Quando você decide testar uma oferta. O resultado real fecha o loop.
model OfferTest {
  id          String   @id @default(cuid())
  offerId     String
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  startedAt   DateTime @default(now())
  angle       String?
  status      String   @default("running") // running | win | loss
  note        String?
  roas        Float?
  profitCents Int?
}

/// Anunciante/página monitorado — a watchlist ("tava com 300, pulou pra 900").
model PageWatch {
  id        String   @id @default(cuid())
  pageId    String   @unique
  pageName  String
  note      String?
  createdAt DateTime @default(now())
}

/// Foto diária do total de anúncios ativos de uma página (nível anunciante).
model PageSnapshot {
  id           String   @id @default(cuid())
  pageId       String
  pageName     String
  at           DateTime @default(now())
  activeAdCount Int

  @@index([pageId, at])
}
